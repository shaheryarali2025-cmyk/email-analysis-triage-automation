    {
      "parameters": {
        "jsCode": "// Saare items Merge node se\nconst items = $input.all();\nconst result = [];\n\n// Gmail label IDs mapping\n// Ye IDs tumhare Get many labels output se li hui hain\nconst labelMap = {\n  Urgent: 'Label_4230498543484052833',\n  'Action Required': 'Label_9058879928456985247',\n  'For Review': 'Label_7792460728373492648',\n  'For Approval': 'Label_6783114676002759534',\n  'Follow-Up': 'Label_2295556826341389640',\n  FYI: 'Label_2784060120517581890',\n  Notification: 'Label_7264284743449325439',\n  Query: 'Label_6549930859083289872',\n  Update: 'Label_2308846325209700632',\n};\n\nfor (const item of items) {\n  const email = item.json;\n\n  // Agent ka raw output string\n  const rawOutput = email.output || '{}';\n  let triage;\n\n  // Robust JSON parse . agar string me do JSON objects chipke hon to last wala le lo\n  try {\n    triage = JSON.parse(rawOutput);\n  } catch (err) {\n    const matches = rawOutput.match(/{[\\s\\S]*?}/g);\n    if (!matches || matches.length === 0) {\n      throw new Error(\n        'Failed to parse AI output JSON. No valid JSON object found. value: ' + rawOutput,\n      );\n    }\n    const lastJson = matches[matches.length - 1];\n    try {\n      triage = JSON.parse(lastJson);\n    } catch (innerErr) {\n      throw new Error(\n        'Failed to parse AI output JSON after splitting. ' +\n          innerErr.message +\n          ' , value: ' +\n          lastJson,\n      );\n    }\n  }\n\n  const category = triage.category || '';\n  const labels = [];\n\n  // Category se Gmail label ID decide karo\n  if (labelMap[category]) {\n    labels.push(labelMap[category]);\n  }\n\n  result.push({\n    json: {\n      // Gmail se basic info\n      emailId: email.id || email.emailId || null,\n      threadId: email.threadId || null,\n      from: email.From || email.from || null,\n      to: email.To || email.to || null,\n      subject: email.Subject || email.subject || null,\n      snippet: email.snippet || null,\n\n      // Label IDs jo Gmail node ko jayengi\n      labels,\n\n      // Pura triage object plus flat fields\n      triage,\n      category: triage.category || '',\n      priority: triage.priority ?? 1,\n      needsTask: !!triage.needsTask,\n      taskTitle: triage.taskTitle || '',\n      taskDue: triage.taskDue || '',\n      needsCalendarEvent: !!triage.needsCalendarEvent,\n      meetingTimeText: triage.meetingTimeText || '',\n      autoReplyNeeded: !!triage.autoReplyNeeded,\n      autoReplyType: triage.autoReplyType || '',\n      summary: triage.summary || '',\n      rawActionNotes: triage.rawActionNotes || '',\n      eventTitle: triage.eventTitle || '',\n      eventStart: triage.eventStart || '',\n      eventEnd: triage.eventEnd || '',\n\n    },\n  });\n}\n\nreturn result;"
      },
