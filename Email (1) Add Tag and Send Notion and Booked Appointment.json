      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "00db07494f27f06ae29b2c0cd4a668832ddc3114bc572214126fe7da2d2b50b3@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Meeting Calendar"
        },
        "start": "={{ $json.eventStart || $now }}",
        "end": "={{ $json.eventEnd || $now.plus(1, 'hour') }}",
        "additionalFields": {
          "attendees": [
            "={{\n(() => {\n  const from = $('Gmail Trigger - Monitor All Accounts').item.json.From || '';\n  const m = from.match(/<([^>]+)>/);\n  return m ? m[1].trim() : from.trim();\n})()\n}}"
          ],
          "conferenceDataUi": {},
          "sendUpdates": "all",
          "summary": "={{\n(() => {\n  // Always read from the Gmail trigger item\n  const emailItem = $('Gmail Trigger - Monitor All Accounts').item.json || {};\n\n  const from = emailItem.From || '';          // e.g. \"Name <email@x.com>\"\n  const subject = emailItem.Subject || 'Meeting';\n\n  let name = '';\n  let email = '';\n\n  if (from) {\n    // Handle \"Name <email@x.com>\" format\n    const m = from.match(/^(.*)<([^>]+)>$/);\n    if (m) {\n      name = (m[1] || '').trim();\n      email = (m[2] || '').trim();\n    } else {\n      // Only email or only name\n      email = from.trim();\n    }\n  }\n\n  const parts = [];\n  if (name) parts.push(name);\n  if (email) parts.push(email);\n  parts.push(subject);   // Always add subject\n\n  return parts.join(' - ');\n})()\n}}"
        }
      },
