    {
      "parameters": {
        "jsCode": "// Get all rows from each sheet node\n// Make sure these names match your Google Sheets nodes exactly\nconst highItems = $items('Read High Sheet');\nconst mediumItems = $items('Read Medium Sheet');\nconst lowItems = $items('Read Low Sheet');\n\n// Helper to turn rows into numbered lines\nfunction buildSection(items, title) {\n  if (!items.length) {\n    return `${title}:\\n(no tasks today)\\n`;\n  }\n\n  const lines = items.map((item, index) => {\n    // Column name in your sheets\n    const msg = item.json.Message || item.json.message || '';\n    return `${index + 1}. ${msg}\n    ------------------------------------------------`;\n  });\n\n  return `${title}:\\n` + lines.join('\\n') + '\\n';\n}\n\n// Build three separate texts\nconst highText = buildSection(highItems, 'HIGH PRIORITY');\nconst mediumText = buildSection(mediumItems, 'MEDIUM PRIORITY');\nconst lowText = buildSection(lowItems, 'LOW PRIORITY');\n\n// Return as one item with three fields\nreturn [\n  {\n    json: {\n      highText,\n      mediumText,\n      lowText,\n    },\n  },\n];"
      },
